load("@rules_java//java:defs.bzl", "java_binary")
load("//bazel:py_rules.bzl", "py_wheel")
load("//bazel/requirements:rules.bzl", "sync_bazelrc_file")
load("//distributions/snowflake-ml-python:packages.bzl", "PACKAGES")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".bazelrc",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.txt",
    "WORKSPACE",
    "mypy.ini",
])

java_binary(
    name = "bazel-diff",
    main_class = "com.bazel_diff.Main",
    runtime_deps = ["@bazel_diff//jar"],
)

py_wheel(
    name = "wheel",
    data = [
        "//:CHANGELOG.md",
        "//:LICENSE.txt",
        "//:README.md",
    ],
    pyproject_toml = "//distributions/snowflake-ml-python:snowml_pyproject",
    deps = PACKAGES,
)

sync_bazelrc_file(
    name = "sync_bazelrc",
    generation_cmd = "bazel run --config=pre_build //:sync_bazelrc",
    root_path = "",
    target = ".bazelrc",
)
