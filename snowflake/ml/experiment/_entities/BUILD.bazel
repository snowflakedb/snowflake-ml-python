load("//bazel:py_rules.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "run_metadata",
    srcs = ["run_metadata.py"],
)

py_library(
    name = "experiment_entity",
    srcs = ["experiment.py"],
    deps = ["//snowflake/ml/_internal/utils:sql_identifier"],
)

py_library(
    name = "entities",
    srcs = [
        "__init__.py",
        "run.py",
    ],
    deps = [
        ":experiment_entity",
        ":run_metadata",
        "//snowflake/ml/_internal/utils:identifier",
        "//snowflake/ml/_internal/utils:sql_identifier",
        "//snowflake/ml/experiment:experiment_info",
        "//snowflake/ml/lineage",
    ],
)

py_test(
    name = "run_test",
    srcs = ["run_test.py"],
    optional_dependencies = ["scikit-learn"],
    tags = [
        "feature:experiment_tracking",
        "short_regress",
    ],
    deps = [
        ":entities",
        "//snowflake/ml/_internal/utils:sql_identifier",
        "//snowflake/ml/experiment:experiment_tracking",
    ],
)
