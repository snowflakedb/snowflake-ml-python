# ---------------------------------------------------------------------------
# Library — client-facade tier (layer 4 of the import-DAG, the top)
#
# The imperative bridge (``imperative_executor.py``: lazy adapter onto the
# imperative ``FeatureStore`` — ``assert_feature_store_initialized`` /
# ``fetch_entity_rows`` / ``fetch_stream_source_rows`` /
# ``_build_feature_view`` / ``execute_plan``), the top-level facade
# (``api.py``: the single entry point the CLI plugin imports — query
# factories, state, planning, enrichment, export, plan-file (de)serialise),
# and the pure service-status parsing helpers (``service.py``).  This is the
# rollup target that pulls in every lower tier of the import-DAG; the
# import-isolation contract (pinned by ``tests/test_wheel_isolation.py``)
# permits only the two stdlib-only siblings ``spec.enums`` /
# ``interval_utils`` from outside the package.
# ---------------------------------------------------------------------------
py_library(
    name = "decl_lib",
    srcs = [
        "api.py",
        "imperative_executor.py",
        "service.py",
    ],
    tags = ["feature:feature_store"],
    deps = [
        ":decl_lib_loader",
        ":decl_lib_planner",
        ":decl_lib_state",
    ],
)

