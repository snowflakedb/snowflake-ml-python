# ---------------------------------------------------------------------------
# Library — state tier (layer 3 of the import-DAG)
#
# Applied-state parsing (``state.py``: ``FeatureView`` / ``Entity`` /
# ``Datasource`` / ``FeatureGroup`` reconstruction from raw rows), the SQL
# string factories (``queries.py``: OFT ``SHOW`` + per-OFT ``DESCRIBE …
# TYPE = SPECIFICATION``), and the YAML exporter (``exporter.py``: spec →
# authoring-format round-trip with UDF / datasource siblings).  ``state.py``
# imports ``decl.invariants`` (structural-fingerprint / full-spec hashing) so
# the tier depends on ``:decl_lib_planner`` rather than ``:decl_lib_loader``
# directly; ``exporter.py`` imports ``decl.state``.  The import-isolation
# contract (pinned by ``tests/test_wheel_isolation.py``) forbids reaching into
# the higher layer (imperative_executor/api/service).
# ---------------------------------------------------------------------------
py_library(
    name = "decl_lib_state",
    srcs = [
        "exporter.py",
        "queries.py",
        "state.py",
    ],
    tags = ["feature:feature_store"],
    deps = [":decl_lib_planner"],
)

