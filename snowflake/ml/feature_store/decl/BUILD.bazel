    name = "spec_models_test",
    srcs = [
        "tests/__init__.py",
        "tests/test_spec_models.py",
    ],
    data = [":decl_loader_test_fixtures"],
    main = "tests/test_spec_models.py",
    tags = ["feature:feature_store"],
    deps = [":decl_lib_loader"],
)

