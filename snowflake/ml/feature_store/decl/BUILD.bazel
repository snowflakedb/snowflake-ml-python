# ---------------------------------------------------------------------------
# Library — planner tier (layer 2 of the import-DAG)
#
# Invariants (validation rules + structural-fingerprint / full-spec hashing),
# the dependency graph (extraction, topological sort, cycle detection), and the
# planner (full-spec-diff plan generation with fingerprint fallback).  Depends
# only on the loader tier; the wheel-isolation contract (pinned by
# ``tests/test_wheel_isolation.py``) forbids reaching into higher layers
# (state/queries/exporter, imperative_executor/api/service).
# ---------------------------------------------------------------------------
py_library(
    name = "decl_lib_planner",
    srcs = [
        "dependencies.py",
        "invariants.py",
        "planner.py",
    ],
    tags = ["feature:feature_store"],
    deps = [":decl_lib_loader"],
)

# Golden SPECIFICATION JSON fixtures consumed by the planner re-validation
# tests via ``Path(__file__).parent / "golden_specs"``.
filegroup(
    name = "decl_golden_specs",
    srcs = glob(["tests/golden_specs/**"]),
)

