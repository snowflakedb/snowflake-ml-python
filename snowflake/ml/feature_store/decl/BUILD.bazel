load("//bazel:py_rules.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Library — loader tier (layer 1 of the import-DAG)
#
# Loading + spec models + templating.  The declarative package is distributed
# as a standalone lightweight wheel; the only intra-repo runtime dependencies
# permitted by the wheel-isolation contract are the two stdlib-only siblings
# ``spec.enums`` (FS enum vocabulary) and ``interval_utils`` (duration parsing),
# both of which live in ``:feature_store_lib``.  The import-isolation contract
# itself is enforced at runtime by ``tests/test_wheel_isolation.py``.
#
# Higher layers of the import-DAG (invariants/dependencies/planner,
# state/queries/exporter, imperative_executor/api/service) extend this BUILD
# file with additional ``py_library`` targets that depend on
# ``:decl_lib_loader``.
# ---------------------------------------------------------------------------
py_library(
    name = "decl_lib_loader",
    srcs = [
        "__init__.py",
        "compiler.py",
        "enums.py",
        "errors.py",
        "loader.py",
        "manifest.py",
        "project_paths.py",
        "serializer.py",
        "spec_compiler.py",
        "spec_models.py",
        "templating.py",
        "types.py",
        "udf_loader.py",
    ],
    tags = ["feature:feature_store"],
    deps = [
        "//snowflake/ml/feature_store:feature_store_lib",
    ],
)

# ---------------------------------------------------------------------------
# Test fixtures
# ---------------------------------------------------------------------------
filegroup(
    name = "decl_loader_test_fixtures",
    srcs = glob(["tests/fixtures/**"]),
)

