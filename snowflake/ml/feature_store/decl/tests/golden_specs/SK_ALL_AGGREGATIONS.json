    "udf": {
      "engine": "pandas",
      "function_definition": "def compute_sk_all_agg_metrics(ad_impressions_stream: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Derive boolean and category columns for all-aggregation SK test.\"\"\"\n    df = ad_impressions_stream.copy()\n    df[\"IS_LONG_WATCH\"] = df[\"WATCH_SECONDS\"] >= 5.0\n    df[\"AD_CATEGORY\"] = \"cat_\" + df[\"AD_ID\"].astype(str)\n    return df[[\"USER_ID\", \"AD_ID\", \"TIMESTAMP\", \"WATCH_SECONDS\", \"IS_LONG_WATCH\", \"AD_CATEGORY\"]]\n",
      "name": "compute_sk_all_agg_metrics",
      "output_columns": [
