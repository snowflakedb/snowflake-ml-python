    "udf": {
      "engine": "pandas",
      "function_definition": "def transform_content_events(df: pd.DataFrame) -> pd.DataFrame:\n    import pandas as pd\n    df = df.copy()\n    df[\"UUID\"] = (\n        df[\"NEW_CONS_GUEST_ID\"]\n        .combine_first(df[\"CONS_GUEST_ID\"])\n        .combine_first(df[\"ANON_GUEST_ID\"])\n    )\n    df[\"RECOMMENDATION_CLICK_ID\"] = df[\"RECOMMENDATION_ID\"].astype(\"string\")\n    df[\"RECOMMENDATION_VIEW_ID\"] = df[\"RECOMMENDATION_ID\"].astype(\"string\")\n    return df[\n        [\"UUID\", \"OFFER_KEY\", \"EVENT_TS\", \"RECOMMENDATION_CLICK_ID\", \"RECOMMENDATION_VIEW_ID\"]\n    ]\n",
      "name": "transform_content_events",
