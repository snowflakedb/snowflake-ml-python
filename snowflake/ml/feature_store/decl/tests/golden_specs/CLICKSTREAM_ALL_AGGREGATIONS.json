    "timestamp_field": "TIMESTAMP",
    "udf": {
      "engine": "pandas",
      "function_definition": "def compute_all_aggregation_metrics(clickstream: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Compute engagement score, conversion flag, and pass through PAGE_URL.\n\n    Exercises all aggregation types: sum, count, max, min (numeric + boolean),\n    avg, stddev, and approx_count_distinct (HLL on strings).\n    \"\"\"\n    df = clickstream.copy()\n\n    event_weights = {\n        \"page_view\": 1.0, \"click\": 2.0, \"scroll\": 0.5,\n        \"form_start\": 3.0, \"form_submit\": 5.0, \"add_to_cart\": 4.0,\n        \"purchase\": 10.0, \"signup\": 8.0,\n    }\n    df[\"ENGAGEMENT_SCORE\"] = df[\"EVENT_TYPE\"].map(event_weights).fillna(1.0)\n\n    conversion_events = [\"purchase\", \"signup\", \"subscribe\", \"checkout_complete\"]\n    df[\"IS_CONVERSION\"] = df[\"EVENT_TYPE\"].isin(conversion_events)\n\n    return df[[\"USER_ID\", \"TIMESTAMP\", \"ENGAGEMENT_SCORE\", \"IS_CONVERSION\", \"PAGE_URL\"]]\n",
      "name": "compute_all_aggregation_metrics",
      "output_columns": [
        {
          "name": "USER_ID",
          "type": "StringType"
        },
        {
          "name": "TIMESTAMP",
          "type": "TimestampType"
        },
        {
          "name": "ENGAGEMENT_SCORE",
          "type": "DoubleType"
        },
        {
          "name": "IS_CONVERSION",
          "type": "BooleanType"
        },
        {
          "name": "PAGE_URL",
          "type": "StringType"
        }
      ]
    }
